{% liquid
  assign featured_collection = section.settings.collection
  assign featured_product = featured_collection.products.first
  assign featured_image = section.settings.image | default: featured_product.featured_image
%}

<div class="section section--page-width seal-intro{% if featured_image != blank %} seal-intro--with-art{% endif %}">
  <div class="seal-intro__copy">
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.description | escape }}</p>
    <nav class="seal-intro__links" aria-label="{{ section.settings.heading | escape }}">
      <a class="button" href="{{ collections.prints.url }}">{{ section.settings.prints_label | escape }}</a>
      <a class="button button-secondary" href="{{ collections.originals.url }}">{{ section.settings.originals_label | escape }}</a>
      <a class="seal-intro__artist" href="https://ellieseal.co.uk/about">{{ section.settings.artist_label | escape }}</a>
    </nav>
  </div>
  {% if featured_image != blank %}
    <a class="seal-intro__art" href="{{ featured_product.url | default: featured_collection.url }}" aria-label="{{ featured_product.title | default: section.settings.heading | escape }}">
      {{ featured_image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 750px) 42vw, 92vw', loading: 'eager', fetchpriority: 'high' }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Shop introduction",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Art for your space"},
    {"type":"text","id":"description","label":"Introduction","default":"Original paintings and art prints by Ellie Seal."},
    {"type":"text","id":"prints_label","label":"Prints link label","default":"Prints"},
    {"type":"text","id":"originals_label","label":"Originals link label","default":"Originals"},
    {"type":"text","id":"artist_label","label":"Artist link label","default":"Meet Ellie"},
    {"type":"collection","id":"collection","label":"Featured artwork collection"},
    {"type":"image_picker","id":"image","label":"Featured image override"}
  ],
  "presets": [{"name":"Shop introduction"}]
}
{% endschema %}
