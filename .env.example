PUBLIC_SHOPIFY_STORE_DOMAIN=
# PUBLIC Storefront token from Shopify's Headless channel. Never an Admin/private token.
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
PUBLIC_SHOPIFY_API_VERSION=2026-07
# Canonical public site origin. Local and other deployment hosts remain noindex.
PUBLIC_SITE_URL=https://ellieseal.co.uk
# Legacy hosted account URL. The custom /account area uses the Customer Account API below.
PUBLIC_CUSTOMER_ACCOUNT_URL=
# Optional: hosted Shopify newsletter page; otherwise native Shopify /contact form.
PUBLIC_NEWSLETTER_URL=

# Server-only Customer Account API configuration (separate from the Storefront API token).
# Create/configure the client in Shopify Headless > Customer Account API.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Optional for a confidential client; leave blank when using a public client with PKCE.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Generate a long random secret; used to encrypt HttpOnly account sessions. Never use PUBLIC_.
CUSTOMER_ACCOUNT_SESSION_SECRET=
# Optional discovery domain override, e.g. account.yourdomain.com. Hostname only.
SHOPIFY_CUSTOMER_ACCOUNT_DOMAIN=
