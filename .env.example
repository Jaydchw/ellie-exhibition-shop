# Closed by default. Set false to enable ecommerce when running Vite or building.
# npm run dev/build -- --construction=true/false overrides this setting for that run.
# Build-time setting: changing it in a deployed runtime requires a new build.
SHOP_UNDER_CONSTRUCTION=true
PUBLIC_SHOPIFY_STORE_DOMAIN=
# PUBLIC Storefront token from Shopify's Headless channel. Never an Admin/private token.
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
PUBLIC_SHOPIFY_API_VERSION=2026-07
# Optional: Shopify-hosted customer account URL, otherwise https://STORE/account.
PUBLIC_CUSTOMER_ACCOUNT_URL=
# Optional: hosted Shopify newsletter page; otherwise native Shopify /contact form.
PUBLIC_NEWSLETTER_URL=
